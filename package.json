{
  "name": "ocr-buddy",
  "version": "2.6.1",
  "description": "Faithful, fully-local OCR Chrome extension. Select a region, get the text — no server, no hallucinations.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "verify:ux": "node scripts/verify-ux.mjs",
    "verify:capture": "node scripts/verify-capture-sources.mjs",
    "verify:md": "node scripts/verify-md.mjs",
    "verify:md-images": "node scripts/verify-md-images.mjs",
    "verify:panel": "node scripts/verify-panel-actions.mjs",
    "verify:layout": "node scripts/verify-result-layout.mjs",
    "verify:pdf": "node scripts/verify-pdf.mjs",
    "verify:update": "node scripts/verify-update-clipboard.mjs",
    "test:merge": "node --experimental-strip-types scripts/test-merge.ts",
    "test:restricted": "node --experimental-strip-types scripts/test-restricted.ts",
    "test:review": "node --experimental-strip-types scripts/test-review.ts",
    "test:capture": "node --experimental-strip-types scripts/test-capture-actions.ts",
    "test:pdf": "node --experimental-strip-types scripts/test-pdf-text.ts",
    "ocr-bench": "node scripts/ocr-bench.mjs",
    "fetch-test-images": "node scripts/fetch-test-images.mjs"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.0.323",
    "@types/katex": "^0.16.8",
    "@webgpu/types": "^0.1.52",
    "playwright": "^1.60.0",
    "typescript": "^5.7.3",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "@types/turndown": "^5.0.6",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.47",
    "onnxruntime-web": "^1.20.1",
    "pdfjs-dist": "5.5.207",
    "ppu-paddle-ocr": "^5.8.3",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
