{
  "name": "ocr-buddy",
  "version": "0.2.5",
  "description": "Faithful, fully-local OCR Chrome extension. Select a region, get the text — no server, no hallucinations.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "verify:ux": "node scripts/verify-ux.mjs",
    "verify:capture": "node scripts/verify-capture-sources.mjs",
    "test:merge": "node --experimental-strip-types scripts/test-merge.ts",
    "ocr-bench": "node scripts/ocr-bench.mjs",
    "fetch-test-images": "node scripts/fetch-test-images.mjs"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.31",
    "@types/chrome": "^0.0.323",
    "@types/katex": "^0.16.8",
    "@webgpu/types": "^0.1.52",
    "playwright": "^1.60.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "katex": "^0.16.47",
    "onnxruntime-web": "^1.20.1",
    "ppu-paddle-ocr": "^5.8.3"
  }
}
